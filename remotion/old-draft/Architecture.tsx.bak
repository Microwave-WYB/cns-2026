import {AbsoluteFill, useCurrentFrame} from 'remotion';
import {SEGMENTS, segmentAt} from './segments';

const BLUE = '#69bfff';
const YELLOW = '#ffd475';
const MUTED = '#8499b3';
const ramp = (f: number, a: number, b: number) => Math.max(0, Math.min(1, (f - a) / (b - a)));
const ease = (t: number) => t * t * (3 - 2 * t);
const mix = (a: number, b: number, t: number) => a + (b - a) * ease(t);
const devices = Array.from({length: 12}, (_, i) => ({
  x: 140 + (i % 4) * 155, y: 280 + Math.floor(i / 4) * 210, id: `d${String(i + 1).padStart(2, '0')}`,
}));
// Synthetic observations, not unique-device or deployment counts. Six sightings per source.
const observations = Array.from({length: 72}, (_, i) => ({
  source: i % 12, family: (i % 12) % 4, row: Math.floor(i / 12),
}));
const fields = [
  ['MAC', '02:00:00:00:00:07', 920, 390],
  ['ADV', '02 01 06 · 03 03 F0 FF · 05 FF 00 00 A1 07', 920, 300],
  ['RSSI', '−64 dBm', 920, 470],
  ['TIME', 't + 2.4 s', 1260, 470],
  ['LOCATION', 'scanner · cell A3', 920, 550],
] as const;
const families = [
  {x: 690, y: 360, label: 'Family A', feature: 'Flags + service UUID'},
  {x: 1230, y: 355, label: 'Family B', feature: 'Name + service UUID'},
  {x: 730, y: 735, label: 'Unknown family', feature: 'Mfg layout + cadence'},
  {x: 1290, y: 735, label: 'Family D', feature: 'Mfg layout + cadence'},
];
function Glyph({kind, color}: {kind: number; color: string}) {
  if (kind % 3 === 0) return <g fill="none" stroke={color} strokeWidth={3}>
    <path d="M-42 12 L-36 -10 L-21 -25 H22 L36 -10 L44 12 Z M-35 -10 H35"/>
    <circle cx={-25} cy={15} r={8}/><circle cx={26} cy={15} r={8}/><rect x={-12} y={-5} width={24} height={12} rx={3}/>
  </g>;
  if (kind % 3 === 1) return <g fill="none" stroke={color} strokeWidth={3}>
    <path d="M-12 -40 H12 V-23 M-12 23 V40 H12 V23"/><rect x={-23} y={-24} width={46} height={48} rx={12}/><path d="M-10 4 L0 -8 L12 8"/>
  </g>;
  return <g fill="none" stroke={color} strokeWidth={3}>
    <rect x={-27} y={-27} width={54} height={54} rx={12}/><circle r={9}/><path d="M-17 -37 V-27 M17 -37 V-27 M-17 27 V37 M17 27 V37"/>
  </g>;
}
export const Architecture = () => {
  const f = useCurrentFrame();
  const collect = ramp(f, 330, 420);
  const cloud = ramp(f, 660, 760);
  const cluster = ramp(f, 775, 955);
  const mapOpacity = 1 - ramp(f, 675, 760) * 0.85;
  const scanX = mix(110, 690, ramp(f, 0, 145));
  const packet = ramp(f, 125, 195);
  const extract = ramp(f, 205, 275);
  const storeOpacity = ramp(f, 355, 405) * (1 - cloud);
  const stage = Math.max(0, segmentAt(f));
  return <AbsoluteFill style={{background: '#09111e', fontFamily: 'Arial, sans-serif'}}>
    <svg viewBox="0 0 1920 1080" width="100%" height="100%" aria-label="Illustrative BLE scanning, observation collection, and clustering">
      <defs>
        <pattern id="grid" width={48} height={48} patternUnits="userSpaceOnUse"><path d="M48 0H0V48" fill="none" stroke="#18263a" strokeWidth={1}/></pattern>
      </defs>
      <rect width={1920} height={1080} fill="url(#grid)" opacity={0.45}/>
      <text x={90} y={90} fill="#e7f1ff" fontSize={32}>BLE observatory</text>
      {SEGMENTS.map((s, i) => <g key={s.label} transform={`translate(${1150 + i * 240} 80)`}>
        <circle r={7} fill={i === stage ? BLUE : '#34435a'}/>
        <text x={22} y={10} fill={i === stage ? '#e7f1ff' : MUTED} fontSize={28}>{s.label}</text>
        {i < 2 && <path d="M155 0H205" stroke={MUTED} strokeDasharray="5 7"/>}
      </g>)}
      <g opacity={mapOpacity} transform={`translate(${mix(0, -80, collect)} ${mix(0, 130, collect)}) scale(${mix(1, 0.63, collect)})`}>
        <path d="M80 465H785 M80 510H785" stroke="#304257" strokeWidth={3}/>
        <path d="M80 488H785" stroke="#65748a" strokeWidth={2} strokeDasharray="25 22"/>
        {devices.map((d, i) => <g key={d.id} transform={`translate(${d.x} ${d.y})`}>
          <Glyph kind={i} color={i === 6 ? YELLOW : BLUE}/>
          <text y={65} textAnchor="middle" fill={i === 6 ? YELLOW : MUTED} fontSize={24}>{d.id}</text>
          {[0, 1, 2].map((n) => {
            const t = ((Math.min(f, 145) + i * 9 + n * 23) % 70) / 70;
            return <circle key={n} r={38 + t * 60} fill="none" stroke={i === 6 ? YELLOW : BLUE} strokeWidth={1.5} opacity={(1 - t) * 0.38 * (1 - ramp(f, 150, 190))}/>;
          })}
        </g>)}
        <g transform={`translate(${scanX} 488)`}>
          <rect x={-34} y={-19} width={68} height={38} rx={8} fill="#102d47" stroke={BLUE} strokeWidth={3}/>
          <path d="M0 -19V-43 M-10 -38Q0 -52 10 -38" stroke={BLUE} strokeWidth={3} fill="none"/>
          <text x={0} y={116} textAnchor="middle" fill={BLUE} fontSize={26}>Passive scanner</text>
        </g>
        {Array.from({length: 18}, (_, i) => {
          const d = devices[i % 12];
          const t = ((Math.min(f, 145) + i * 17) % 95) / 95;
          return <g key={i} opacity={(1 - ramp(f, 145, 185)) * 0.9}>
            <path d={`M${d.x} ${d.y}L${scanX} 488`} stroke={BLUE} strokeDasharray="5 10" opacity={0.13}/>
            <rect x={mix(d.x, scanX, t) - 10} y={mix(d.y, 488, t) - 5} width={20} height={10} rx={3} fill={i % 12 === 6 ? YELLOW : BLUE}/>
          </g>;
        })}
      </g>
      {/* The same selected d07 advertisement expands; metadata comes from the scanner. */}
      <g opacity={packet * (1 - collect)}>
        <path d="M450 488Q630 380 890 285" stroke={YELLOW} strokeDasharray="7 9" fill="none" opacity={0.7}/>
        <rect x={mix(450, 885, packet)} y={mix(485, 205, packet)} width={mix(25, 820, packet)} height={mix(12, 420, packet)} rx={14} fill="#102038" stroke={BLUE} strokeWidth={2}/>
        <g opacity={extract}>
          <text x={920} y={250} fill={YELLOW} fontSize={28}>d07 · selected sighting</text>
          <text x={920} y={285} fill={BLUE} fontSize={20}>ADV PAYLOAD · flags / service UUID / manufacturer bytes</text>
          <path d="M910 420H1680" stroke="#344b65"/>
          <text x={920} y={450} fill={MUTED} fontSize={20}>OBSERVATION METADATA · attached by scanner</text>
          {fields.map(([name, value, x, y]) => <g key={name}>
            <text x={x} y={y + (name === 'MAC' ? -30 : 15)} fill={MUTED} fontSize={20}>{name === 'MAC' ? 'SOURCE ADDRESS · synthetic' : name === 'ADV' ? '' : name}</text>
            <text x={x} y={y + (name === 'MAC' ? 0 : 45)} fill={name === 'MAC' ? YELLOW : '#e7f1ff'} fontSize={name === 'ADV' ? 26 : 27} fontFamily="monospace">{value}</text>
          </g>)}
        </g>
      </g>
      <g opacity={storeOpacity}>
        <text x={720} y={230} fill="#e7f1ff" fontSize={34}>Structured observations</text>
        <text x={720} y={270} fill={MUTED} fontSize={24}>One row per sighting · provenance retained</text>
        {['source', 'ADV structure', 'RSSI', 'time', 'scanner cell'].map((s, i) => <text key={s} x={[730, 900, 1240, 1370, 1510][i]} y={330} fill={MUTED} fontSize={23}>{s}</text>)}
        <path d="M710 350H1720" stroke={BLUE} strokeDasharray="6 7"/>
        {Array.from({length: 6}, (_, row) => {
          const a = ramp(f, 405 + row * 28, 425 + row * 28);
          return <g key={row} opacity={a} transform={`translate(0 ${mix(20, 0, a)})`}>
            <rect x={710} y={371 + row * 68} width={1010} height={57} fill={row === 3 ? '#302c24' : '#122137'} rx={5}/>
            <text x={730} y={407 + row * 68} fill={row === 3 ? YELLOW : BLUE} fontSize={26} fontFamily="monospace">{row === 3 ? 'd07' : devices[row * 2].id}</text>
            {[0,1,2,3,4,5].map((v) => <rect key={v} x={900 + v * 45} y={391 + row * 68} width={33} height={13 + (v % 3) * 3} rx={2} fill={row === 3 ? YELLOW : BLUE} opacity={0.4 + (v % 3) * 0.2}/>)}
            <text x={1240} y={407 + row * 68} fill="#c4d5e9" fontSize={24}>−{row === 3 ? 64 : 61 + row * 3}</text>
            <text x={1370} y={407 + row * 68} fill="#c4d5e9" fontSize={24}>+{row === 3 ? 2 : 2 + row}.4s</text>
            <text x={1510} y={407 + row * 68} fill="#c4d5e9" fontSize={24}>S1 / A{row < 4 ? '3' : '4'}</text>
          </g>;
        })}
        <path d="M270 550Q540 510 700 607" stroke={YELLOW} fill="none" strokeDasharray="8 8"/>
        <text x={720} y={875} fill={MUTED} fontSize={25}>Repeated sightings accumulate; addresses are not identity.</text>
      </g>
      {observations.map((o, i) => {
        const visible = ramp(f, 375 + i * 3, 395 + i * 3);
        const target = families[o.family];
        const local = Math.floor(i / 4);
        const angle = local * 2.39996;
        const radius = 30 + Math.sqrt(local) * 25;
        const sx = 730 + (i % 12) * 83;
        const sy = 399 + o.row * 68;
        const cx = 680 + ((i * 127) % 900);
        const cy = 310 + ((i * 79) % 500);
        const x = mix(mix(mix(devices[o.source].x * .63 - 80, sx, visible), cx, cloud), target.x + Math.cos(angle) * radius, cluster);
        const y = mix(mix(mix(devices[o.source].y * .63 + 130, sy, visible), cy, cloud), target.y + Math.sin(angle) * radius * 0.7, cluster);
        const selected = o.source === 6;
        return <g key={i} opacity={visible}>
          {f < 660 && <path d={`M${devices[o.source].x * .63 - 80} ${devices[o.source].y * .63 + 130}Q520 470 ${sx} ${sy}`} fill="none" stroke={selected ? YELLOW : BLUE} opacity={0.1 * (1 - ramp(f, 600, 650))} strokeDasharray="4 11"/>}
          <circle cx={x} cy={y} r={mix(3, selected ? 9 : 6, cloud)} fill={selected ? YELLOW : BLUE} opacity={selected ? 1 : 0.6}/>
          {selected && cloud > 0 && <circle cx={x} cy={y} r={15} fill="none" stroke={YELLOW} opacity={cloud * 0.8}/>}
        </g>;
      })}
      <g opacity={ramp(f, 725, 790)}>
        <text x={90} y={220} fill="#e7f1ff" fontSize={34}>Structure + behavior</text>
        <text x={90} y={260} fill={MUTED} fontSize={25}>Illustrative similarity projection</text>
        <path d="M450 885H1700 M480 910V270" stroke="#34465e" fill="none" strokeDasharray="6 9"/>
        <text x={1450} y={925} fill={MUTED} fontSize={22}>ADV structure →</text>
        {families.map((family, i) => <g key={family.label} opacity={cluster}>
          <ellipse cx={family.x} cy={family.y} rx={173} ry={130} fill={i === 2 ? '#ffd47508' : '#69bfff05'} stroke={i === 2 ? YELLOW : BLUE} strokeWidth={i === 2 ? 2 : 1} strokeDasharray="7 9"/>
          <text x={family.x} y={family.y - 150} textAnchor="middle" fill={i === 2 ? YELLOW : '#c4d5e9'} fontSize={30}>{family.label}</text>
          <text x={family.x} y={family.y + 158} textAnchor="middle" fill={MUTED} fontSize={22}>{family.feature}</text>
        </g>)}
        <g opacity={cluster}>
          <g transform="translate(175 825)"><Glyph kind={6} color={YELLOW}/><text x={55} y={10} fill={YELLOW} fontSize={26}>d07 sightings</text></g>
          <path d="M330 825Q450 680 730 735" fill="none" stroke={YELLOW} strokeDasharray="7 9"/>
          <text x={90} y={965} fill={YELLOW} fontSize={30}>Similarity ≠ product identity</text>
        </g>
      </g>
      <text x={90} y={1035} fill={MUTED} fontSize={23}>Illustrative architecture · synthetic data · proposed flow</text>
      <path d="M1430 1027H1490" stroke={MUTED} strokeDasharray="6 7"/>
      <text x={1505} y={1035} fill={MUTED} fontSize={23}>Proposed connection</text>
    </svg>
  </AbsoluteFill>;
};

