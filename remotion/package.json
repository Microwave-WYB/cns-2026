{
  "name": "cns-2026-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts CNSIntro out/preview.png --frame=90",
    "render": "remotion render src/index.ts CNSIntro out/intro.mp4",
    "presenter": "vite --host 127.0.0.1",
    "build": "vite build",
    "check:playback": "node --experimental-strip-types checks/playback.mjs",
    "render:architecture": "remotion render src/index.ts Architecture out/architecture.mp4 --concurrency=2"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/player": "4.0.534",
    "remotion": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}


